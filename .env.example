# KnowledgeTree 环境变量模板
# 项目不会自动加载 .env；请在启动前 export，或直接在设置页配置。
# 大多数情况下推荐使用设置页：/ui/settings.html

# ========================================
# 服务器
# ========================================

# 默认只监听本机。需要局域网访问时改成 0.0.0.0。
HOST=127.0.0.1
PORT=8000

# ========================================
# 安全（可选）
# ========================================

# 设置密码后启用 HTTP Basic Auth；健康检查 /api/health 不拦截。
KT_AUTH_USER=admin
KT_AUTH_PASSWORD=

# 跨域来源白名单，逗号分隔；留空表示只允许同源。
# 例：CORS_ORIGINS=http://localhost:8700,http://127.0.0.1:8700
CORS_ORIGINS=

# ========================================
# 模型服务（OpenAI chat-completions 兼容）
# ========================================

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/chat/completions
MODEL=deepseek-v4-flash

# ========================================
# MinerU OCR（可选）
# ========================================

MINERU_TOKEN=

# ========================================
# 可选：自定义统一配置文件位置
# ========================================

KT_SETTINGS_PATH=

# 说明：
# - 仓库不内置任何 API Key；请通过设置页或环境变量配置。
# - MAX_CONCURRENT、NO_SPLIT_SIZE_MB、API_TIMEOUT、MAX_TEXT_CHUNK_CHARS
#   目前是代码内常量，不从环境变量读取。
# - RECOVERY_SEEDS 仅用于 test_hierarchy_recovery.py。
