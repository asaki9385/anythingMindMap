# KnowledgeTree 环境变量配置模板
# 复制为 .env 文件（生产环境）或设置系统环境变量

# ========================================
# API 配置
# ========================================

# DeepSeek API 密钥（必需）
OPENAI_API_KEY=sk-your_deepseek_api_key_here

# API 基础地址（兼容 OpenAI 格式的任意服务商）
API_BASE_URL=https://api.deepseek.com/chat/completions

# 使用的模型名称
API_MODEL=deepseek-v4-flash

# DeepSeek API 端点
OPENAI_BASE_URL=https://api.deepseek.com/chat/completions

# 使用的模型
MODEL=deepseek-v4-flash

# API 超时时间（秒）
API_TIMEOUT=30

# API 请求间隔（秒）
REQUEST_DELAY=0.5

# MinerU 云 OCR API 密钥（可选，启用增强 PDF 解析）
MINERU_API_KEY=

# ========================================
# 服务器配置
# ========================================

# 监听地址
HOST=0.0.0.0

# 监听端口
PORT=8000

# Uvicorn 工作进程数（0 = CPU核心数）
WORKERS=0

# 日志级别 (critical, error, warning, info, debug)
LOG_LEVEL=info

# Python 无缓冲输出
PYTHONUNBUFFERED=1

# ========================================
# 文件处理配置
# ========================================

# 文本单次切分的最大字符数
MAX_TEXT_CHUNK_CHARS=8000

# PDF 切分的大小阈值（MB）
NO_SPLIT_SIZE_MB=200

# 临时文件目录
TEMP_DIR=/var/knowledge-tree/data/_temp_uploads

# 日志目录
LOG_DIR=/var/knowledge-tree/logs

# ========================================
# 跨域配置
# ========================================

# 允许的跨域源 (逗号分隔，* 表示所有)
CORS_ORIGINS=*

# 允许的请求方法
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# 允许的请求头
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ========================================
# 并发控制
# ========================================

# 最大并发任务数
MAX_CONCURRENT=5

# 单个任务最大重试次数
MAX_RETRIES=3

# 队列最大长度
QUEUE_MAX_SIZE=100

# ========================================
# 数据库配置（可选，如使用）
# ========================================

# 数据库类型 (sqlite, postgresql, mysql)
# DB_TYPE=sqlite

# 数据库连接字符串
# DATABASE_URL=sqlite:///./test.db

# ========================================
# Redis 配置（可选，如用于缓存）
# ========================================

# Redis 主机
# REDIS_HOST=localhost

# Redis 端口
# REDIS_PORT=6379

# Redis 密码
# REDIS_PASSWORD=

# Redis 数据库编号
# REDIS_DB=0

# ========================================
# 监控和日志配置
# ========================================

# Sentry 错误跟踪（可选）
# SENTRY_DSN=

# 是否启用性能监控
ENABLE_MONITORING=false

# ========================================
# 安全配置
# ========================================

# 是否启用认证
ENABLE_AUTH=false

# JWT 密钥（如启用认证）
# JWT_SECRET_KEY=your_secret_key_here_change_in_production

# ========================================
# 邮件配置（可选，用于通知）
# ========================================

# 邮件服务器
# MAIL_SERVER=smtp.gmail.com

# 邮件端口
# MAIL_PORT=587

# 邮件用户名
# MAIL_USERNAME=your_email@gmail.com

# 邮件密码
# MAIL_PASSWORD=your_password

# 发件人地址
# MAIL_FROM=noreply@example.com

# ========================================
# 使用说明
# ========================================

# 1. Docker 环境
#    在 docker-compose.yml 中设置:
#    environment:
#      - OPENAI_API_KEY=${OPENAI_API_KEY}
#      - ...
#
# 2. Linux Systemd 环境
#    在 /etc/systemd/system/knowledge-tree.service 中设置:
#    Environment="OPENAI_API_KEY=sk-xxxxx"
#
# 3. Windows 环境
#    在命令行中设置:
#    set OPENAI_API_KEY=sk-xxxxx
#    或在 Python 中：
#    import os
#    os.environ['OPENAI_API_KEY'] = 'sk-xxxxx'
#
# 4. 生产环境最佳实践
#    - 不要在代码中硬编码密钥
#    - 使用系统环境变量或密钥管理系统
#    - 定期轮换密钥
#    - 在 .gitignore 中添加 .env 文件
#
# ========================================

# ========== 常见配置 ==========

# 开发环境
# OPENAI_API_KEY=sk-test_key
# LOG_LEVEL=debug
# WORKERS=1

# 生产环境小规模
# OPENAI_API_KEY=sk-prod_key
# LOG_LEVEL=info
# WORKERS=4
# MAX_CONCURRENT=10

# 生产环境大规模
# OPENAI_API_KEY=sk-prod_key
# LOG_LEVEL=warning
# WORKERS=8
# MAX_CONCURRENT=50
# ENABLE_MONITORING=true
